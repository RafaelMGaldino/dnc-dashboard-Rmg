# Node modules (pacotes instalados)
node_modules/

# Build output (quando fizer build)
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operacional
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
.history/

# Arquivos temporários do sistema e editores
*.swp
*.swo
*~

# Cache do Vite
node_modules/.vite/

# Typescript
*.tsbuildinfo

# Arquivos gerados pelo npm
package-lock.json
yarn.lock

# Arquivos específicos do sistema Windows
*.exe
*.dll

# Outros arquivos temporários
*.log

# Cobertura de testes (se usar alguma ferramenta de testes)
coverage/

# Configurações locais, não versionar
.env
.env.local
.env.*.local

